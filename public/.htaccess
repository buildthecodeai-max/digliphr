Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # When document root IS public/, keep RewriteBase /
    # When reached via project-root rewrite (/public/...), Apache/LiteSpeed still resolves correctly
    RewriteBase /

    # Front controller — send non-files through index.php
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [L]
</IfModule>

# Deny access to hidden files
<FilesMatch "^\.">
    Require all denied
</FilesMatch>
