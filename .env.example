APP_NAME="Employee Management System"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_KEY=
APP_TIMEZONE=Asia/Karachi

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=employee_management
DB_USERNAME=root
DB_PASSWORD=

SESSION_LIFETIME=120
SESSION_SECURE=false
REMEMBER_ME_DAYS=30
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
PASSWORD_RESET_MAX_REQUESTS_PER_HOUR=5
# Comma-separated proxy IPs/CIDRs. Leave empty when directly exposed.
TRUSTED_PROXIES=

# Set true only when the site is served over HTTPS.
SECURITY_HSTS=false

MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME="${APP_NAME}"

ATTENDANCE_DEFAULT_RADIUS=100
ATTENDANCE_GPS_ACCURACY_THRESHOLD=50
ATTENDANCE_IMAGE_RETENTION_DAYS=365
ATTENDANCE_LOCATION_RETENTION_DAYS=365

UPLOAD_MAX_SIZE=5242880
CURRENCY=PKR
DATE_FORMAT=Y-m-d
TIME_FORMAT=H:i
